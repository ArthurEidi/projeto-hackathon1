  "titulo": "O Triângulo Escondido Entre Dois Pontos",
  "subtitulo": "Distância e ponto médio",
  "glossario": {
    "c1": {
      "nome": "Deslocamento horizontal",
      "resumo": "Quanto se anda em x de A até B: Δx = xB − xA."
    },
    "c2": {
      "nome": "Deslocamento vertical",
      "resumo": "Quanto se anda em y de A até B: Δy = yB − yA."
    },
    "c3": {
      "nome": "Distância",
      "resumo": "Comprimento do segmento AB, a hipotenusa do triângulo."
    },
    "c4": {
      "nome": "Ponto médio",
      "resumo": "O ponto no meio de A e B: média das coordenadas."
    }
  },
