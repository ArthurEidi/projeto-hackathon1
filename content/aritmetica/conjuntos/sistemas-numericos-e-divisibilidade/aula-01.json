            "correct": true,
            "feedback": "Certo: Z; −2 é inteiro; 0,5 não é inteiro."
          },
          {
            "id": "f2-sistemas-numericos-e-divisibilidade-erro",
            "label": "N",
            "correct": false,
            "feedback": "Naturais não incluem negativos. O certo é Z; −2 é inteiro; 0,5 não é inteiro."
          }
        ]
      },
      {
        "id": "f3-sistemas-numericos-e-divisibilidade",
        "prompt": "0,5 é racional?",
        "options": [
          {
            "id": "f3-sistemas-numericos-e-divisibilidade-erro",
            "label": "Não",
            "correct": false,
            "feedback": "Você confundiu não inteiro com irracional. O certo é Sim; 0,5=1/2."
          },
          {
            "id": "f3-sistemas-numericos-e-divisibilidade-certa",
            "label": "Sim",
            "correct": true,
            "feedback": "Certo: Sim; 0,5=1/2."
          }
        ]
      },
      {
        "id": "f4-sistemas-numericos-e-divisibilidade",
        "prompt": "1 é primo?",
        "options": [
