            "id": "f4-sistemas-numericos-e-divisibilidade-certa",
            "label": "Não",
            "correct": true,
            "feedback": "Certo: Não; 1 tem só o divisor positivo 1."
          },
          {
            "id": "f4-sistemas-numericos-e-divisibilidade-erro",
            "label": "Sim",
            "correct": false,
            "feedback": "Primo exige dois divisores positivos distintos. O certo é Não; 1 tem só o divisor positivo 1."
          }
        ]
      }
    ],
    "medias": [
      {
        "id": "m1-sistemas-numericos-e-divisibilidade",
        "prompt": "Qual resto deixa 7 dividido por 3?",
        "options": [
          {
            "id": "m1-sistemas-numericos-e-divisibilidade-erro",
            "label": "2",
            "correct": false,
            "feedback": "Você respondeu o quociente. O certo é 1; 7=3·2+1."
          },
          {
            "id": "m1-sistemas-numericos-e-divisibilidade-certa",
            "label": "1",
            "correct": true,
            "feedback": "Certo: 1; 7=3·2+1."
          }
        ]
      },
      {
        "id": "m2-sistemas-numericos-e-divisibilidade",
        "prompt": "Qual é a fatoração prima de 12?",
        "options": [
          {
            "id": "m2-sistemas-numericos-e-divisibilidade-certa",
            "label": "2²·3",
            "correct": true,
            "feedback": "Certo: 2²·3; 12=2·2·3."
          },
          {
            "id": "m2-sistemas-numericos-e-divisibilidade-erro",
            "label": "2·6",
            "correct": false,
            "feedback": "Você deixou um fator composto. O certo é 2²·3; 12=2·2·3."
          }
        ]
      },
      {
        "id": "m3-sistemas-numericos-e-divisibilidade",
        "prompt": "Qual é o maior divisor comum de 6 e 8?",
        "options": [
          {
            "id": "m3-sistemas-numericos-e-divisibilidade-erro",
            "label": "24",
            "correct": false,
            "feedback": "Você confundiu divisor comum com múltiplo comum. O certo é 2; Divisores comuns: 1 e 2."
          },
          {
            "id": "m3-sistemas-numericos-e-divisibilidade-certa",
            "label": "2",
            "correct": true,
            "feedback": "Certo: 2; Divisores comuns: 1 e 2."
          }
        ]
      }
    ],
    "desafios": [
      {
        "id": "d1-sistemas-numericos-e-divisibilidade",
        "prompt": "Qual é o menor múltiplo comum positivo de 4 e 6?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d1-sistemas-numericos-e-divisibilidade-certa",
            "label": "12",
            "correct": true,
            "feedback": "Certo: 12; 12=4·3=6·2."
          },
          {
            "id": "d1-sistemas-numericos-e-divisibilidade-erro",
            "label": "2",
            "correct": false,
            "feedback": "Você calculou o máximo divisor comum. O certo é 12; 12=4·3=6·2."
          }
        ]
      },
      {
        "id": "d2-sistemas-numericos-e-divisibilidade",
        "prompt": "Zero é múltiplo de 3?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d2-sistemas-numericos-e-divisibilidade-erro",
            "label": "Não",
            "correct": false,
            "feedback": "O multiplicador pode ser zero. O certo é Sim; 0=3·0."
          },
          {
            "id": "d2-sistemas-numericos-e-divisibilidade-certa",
            "label": "Sim",
            "correct": true,
            "feedback": "Certo: Sim; 0=3·0."
          }
        ]
      },
      {
        "id": "d3-sistemas-numericos-e-divisibilidade",
        "prompt": "√2 pertence a Q?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d3-sistemas-numericos-e-divisibilidade-certa",
            "label": "Não",
            "correct": true,
            "feedback": "Certo: Não; √2 é irracional."
          },
          {
            "id": "d3-sistemas-numericos-e-divisibilidade-erro",
            "label": "Sim",
            "correct": false,
            "feedback": "Nem todo real é uma razão de inteiros. O certo é Não; √2 é irracional."
          }
        ]
      },
      {
        "id": "d4-sistemas-numericos-e-divisibilidade",
        "prompt": "Qual inteiro n deixa quociente 2 e resto 1 na divisão por 3?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d4-sistemas-numericos-e-divisibilidade-erro",
            "label": "6",
            "correct": false,
            "feedback": "Você esqueceu o resto. O certo é 7; n=3·2+1=7."
          },
          {
            "id": "d4-sistemas-numericos-e-divisibilidade-certa",
            "label": "7",
            "correct": true,
            "feedback": "Certo: 7; n=3·2+1=7."
          }
        ]
      },
      {
        "id": "d5-sistemas-numericos-e-divisibilidade",
        "prompt": "Sinais piscam a cada 4 e 6 segundos, juntos no início; em quantos segundos coincidem de novo?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d5-sistemas-numericos-e-divisibilidade-certa",
            "label": "12",
            "correct": true,
            "feedback": "Certo: 12; mmc(4;6)=12."
          },
          {
            "id": "d5-sistemas-numericos-e-divisibilidade-erro",
            "label": "24",
            "correct": false,
            "feedback": "Você multiplicou sem procurar o primeiro múltiplo comum. O certo é 12; mmc(4;6)=12."
          }
        ]
      }
    ],
    "vestibular": []
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra."
}
