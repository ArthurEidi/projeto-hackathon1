            "correct": false,
            "feedback": "Você usou outra convenção. O certo é Sim; N={0,1,2,…}."
          },
          {
            "id": "f1-sistemas-numericos-e-divisibilidade-certa",
            "label": "Sim",
            "correct": true,
            "feedback": "Certo: Sim; N={0,1,2,…}."
          }
        ]
      },
      {
        "id": "f2-sistemas-numericos-e-divisibilidade",
