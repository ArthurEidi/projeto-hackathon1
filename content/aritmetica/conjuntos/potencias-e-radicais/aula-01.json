{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Potenciação, propriedades e radicais",
  "subtitulo": "Repetir fatores e desfazer áreas",
  "caminho": {
    "pilar": "aritmetica",
    "setor": "conjuntos",
    "unidade": "potencias-e-radicais"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Base a",
      "resumo": "Fator repetido na potência."
    },
    "c2": {
      "nome": "Expoente n",
      "resumo": "Quantidade de fatores ou regra de inversão."
    },
    "c3": {
      "nome": "Potência",
      "resumo": "Resultado de aplicar o expoente à base."
    },
    "c4": {
      "nome": "Raiz principal",
      "resumo": "Comprimento não negativo recuperado da área."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [
          -2,
          3
        ],
        "y": [
          0,
          9
        ],
        "grade": true,
        "curvas": [
          {
            "tipo": "exponencial",
            "a": 1,
            "b": 2,
            "c": 0,
            "cor": "c3",
            "rotulo": "2ˣ"
          }
        ],
        "ponto": {
          "x": 1,
          "passo": 1,
          "arrastavel": true,
          "cor": "c3",
          "coordenadas": true,
          "rastro": true
        }
      },
      "lines": {
        "intro": "No caso neutro 2¹=2; ao avançar o expoente para 2, somamos 2 ou multiplicamos por 2?",
        "done": "Multiplicamos; 2²=2·2=4, por isso juntar fatores soma seus expoentes."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Há expoentes inteiros e fracionários; aqui ligamos fatores, inversos e raízes reais, com atenção aos sinais."
      },
      "complete_when": {
        "metric": "ponto_x",
        "gte": 2
      }
    },
    {
      "id": "andar-para-tras",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [
          -2,
          3
        ],
        "y": [
          0,
          9
        ],
        "grade": true,
        "curvas": [
          {
            "tipo": "exponencial",
            "a": 1,
            "b": 2,
            "c": 0,
            "cor": "c3",
            "rotulo": "2ˣ"
          }
        ],
        "ponto": {
          "x": 1,
          "passo": 1,
          "arrastavel": true,
          "cor": "c3",
          "coordenadas": true,
          "rastro": true
        }
      },
      "lines": {
        "intro": "Se cada avanço dobra a saída, voltar até −1 exige qual operação?",
        "done": "Exige dividir por 2; por isso 2⁰=1 e 2⁻¹=1/2."
      },
      "complete_when": {
        "metric": "ponto_x",
        "lte": -1
      }
    },
    {
      "id": "recuperar-lado",
      "type": "interactive_canvas",
      "widget": "retangulo_areas",
      "params": {
        "modo": "raiz",
        "A": "$area",
        "referencia": true,
        "limite": 4
      },
      "controls": [
        {
          "id": "area",
          "label": "Área",
          "min": 1,
          "max": 9,
          "step": 1,
          "initial": 1,
          "color": "c3"
        }
      ],
      "lines": {
        "intro": "Um quadrado de área 9 pode ter lado −3? Leve a área a 9.",
        "done": "Não; comprimento é não negativo, por isso √9=3, embora x²=9 aceite x=±3."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "√(a²) sempre é a?",
        "resposta": "Não; com a=−2, √4=2, então o resultado é ∣a∣."
      },
      "complete_when": {
        "metric": "area",
        "gte": 9
      }
    },
