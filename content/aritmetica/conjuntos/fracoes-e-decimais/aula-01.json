          {
            "id": "d5-fracoes-e-decimais-certa",
            "label": "3/4 m",
            "correct": true,
            "feedback": "Certo: 3/4 m; 2−1/2−3/4=8/4−2/4−3/4=3/4."
          },
          {
            "id": "d5-fracoes-e-decimais-erro3",
            "label": "1/2 m",
            "correct": false,
            "feedback": "Você somou os cortes como 3/2 m ao subtrair de 2 m. O certo é 3/4 m; 2−1/2−3/4=3/4."
          }
        ]
      }
    ],
