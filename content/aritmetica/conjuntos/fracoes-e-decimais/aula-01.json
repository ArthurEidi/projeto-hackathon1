          {
            "id": "d5-fracoes-e-decimais-erro2",
            "label": "5/4 m",
            "correct": false,
            "feedback": "Você somou apenas os dois cortes sem tirar de 2 m. O certo é 3/4 m; 2−1/2−3/4=3/4."
