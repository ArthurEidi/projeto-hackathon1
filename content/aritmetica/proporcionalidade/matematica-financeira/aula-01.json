{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Juro Sobre Juro",
  "subtitulo": "Juros simples e compostos",
  "caminho": {
    "pilar": "aritmetica",
    "setor": "proporcionalidade",
    "unidade": "matematica-financeira"
  },
  "outro": "Você comparou parcela fixa e fator reaplicado; os saldos coincidem no primeiro período e se separam depois.",
  "glossario": {
    "c1": {
      "nome": "Capital C",
      "resumo": "Saldo inicial."
    },
    "c2": {
      "nome": "Taxa i",
      "resumo": "Fração aplicada em cada período."
    },
    "c3": {
      "nome": "Período t",
      "resumo": "Número de aplicações da taxa."
    },
    "c4": {
      "nome": "Montante M",
      "resumo": "Capital mais juros ao final."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "barras",
      "params": {
        "modo": "sequencia",
        "casas": 2,
        "nome": "M",
        "regra": "pg",
        "a1": 100,
        "q": 1,
        "termos": 6,
        "n": "1+$t"
      },
      "controls": [
        {
          "id": "t",
          "label": "Períodos",
          "min": 0,
          "max": 5,
          "step": 1,
          "initial": 0,
          "color": "c3"
        }
      ],
      "lines": {
        "intro": "Em t = 0, o saldo já ganhou juros? Avance o tempo e confira; a primeira barra é o instante t = 0.",
        "done": "Em t = 0, ou com taxa zero, M = C: o saldo fica em 100. Juros só nascem com taxa e tempo."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Taxas e descontos aparecem no mesmo modelo?",
        "resposta": "Usam fatores percentuais; hoje isolamos juros simples e compostos."
      },
      "complete_when": {
        "metric": "t",
        "gte": 3
      }
    },
    {
      "id": "contraste-de-regras",
      "type": "interactive_canvas",
      "widget": "barras",
      "params": {
        "modo": "sequencia",
        "casas": 2,
        "nome": "M",
        "regra": "pa",
        "a1": 100,
        "d": 10,
        "termos": 6,
        "n": "1+$t",
        "degraus": true
      },
      "controls": [
        {
          "id": "t",
          "label": "Períodos",
          "min": 0,
          "max": 5,
          "step": 1,
          "initial": 0,
          "color": "c3"
        }
      ],
      "lines": {
        "intro": "R$ 100 a 10% simples rendem quanto no primeiro período? Avance t até 2 e veja cada degrau.",
        "done": "Rende R$ 10 por período: a base continua sendo o capital inicial. Em t = 2, M = 120."
      },
      "complete_when": {
        "metric": "t",
        "gte": 2
      }
    },
    {
      "id": "teste-de-fronteira",
      "type": "interactive_canvas",
      "widget": "barras",
      "params": {
        "modo": "sequencia",
        "casas": 2,
        "nome": "M",
        "regra": "pg",
        "a1": 100,
        "q": 1.1,
        "termos": 6,
        "n": "1+$t",
        "fantasma": {
          "regra": "pa",
          "a1": 100,
          "d": 10,
          "q": 1
        }
      },
      "controls": [
        {
          "id": "t",
          "label": "Períodos",
          "min": 0,
          "max": 5,
          "step": 1,
          "initial": 0,
          "color": "c3"
        }
      ],
      "lines": {
        "intro": "No composto, após um período, a taxa incide em 100 ou 110? Leve t até 2 e compare com o simples, em cinza.",
        "done": "Incide em 110: o segundo juro é 11, não 10. O saldo atualizado vira a nova base."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Dá para misturar taxa por mês com tempo em anos?",
        "resposta": "Não. Taxa e tempo precisam da mesma unidade, ou o período não bate com a taxa."
      },
      "complete_when": {
        "metric": "t",
        "gte": 2
      }
    },
    {
      "id": "micro-desafio",
      "type": "micro_challenge",
      "figure": {
        "widget": "barras_figura",
        "params": {
          "modo": "sequencia",
          "casas": 2,
          "nome": "M",
          "regra": "pg",
          "a1": 100,
          "q": 1.1,
          "termos": 3,
          "n": 3,
          "fantasma": {
            "regra": "pa",
            "a1": 100,
            "d": 10,
            "q": 1
          }
        }
      },
      "prompt": "R$ 100 a 10% composto por dois períodos. Qual montante?",
      "lines": {
        "intro": "Em cada período, a taxa age sobre o saldo do período anterior. Qual resposta a figura sustenta?"
      },
      "options": [
        {
          "id": "o1",
          "label": "R$ 121",
          "correct": true,
          "feedback": "Certo. 100·1,1² = 121; o segundo juro incide em 110.",
          "figure": {
            "acesos": [
              3
            ]
          }
        },
        {
          "id": "o2",
          "label": "R$ 120",
          "correct": false,
          "feedback": "R$ 120 é simples; composto dá 100·1,1² = 121.",
          "figure": {
            "acesos": [
              2,
              3
            ]
          }
        }
      ]
    },
    {
      "id": "fechamento",
      "type": "concept_lock",
      "figure": {
        "widget": "barras_figura",
        "params": {
          "modo": "sequencia",
          "casas": 2,
          "nome": "M",
          "regra": "pg",
