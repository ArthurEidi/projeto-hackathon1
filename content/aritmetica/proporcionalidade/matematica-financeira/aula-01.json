            "a1": 100,
            "d": 10,
            "q": 1
          }
        }
      },
      "formula": [
        {
          "text": "M",
          "ref": "c4"
        },
        {
          "text": "(simples) ="
        },
        {
          "text": "C",
          "ref": "c1"
        },
        {
          "text": "(1 +"
        },
        {
          "text": "i",
          "ref": "c2"
        },
        {
          "text": "·"
        },
        {
          "text": "t",
          "ref": "c3"
        },
        {
          "text": ")"
        },
        {
          "text": "|"
        },
        {
          "text": "M",
          "ref": "c4"
        },
        {
          "text": "(composto) ="
        },
        {
          "text": "C",
          "ref": "c1"
        },
        {
          "text": "(1 +"
        },
        {
          "text": "i",
          "ref": "c2"
        },
        {
          "text": ")",
          "sup": "t",
          "ref": "c3"
        }
      ],
      "definitions": [
        {
          "term": "Simples",
          "text": "a taxa incide no capital inicial."
        },
        {
          "term": "Composto",
          "text": "a taxa incide no saldo atualizado."
        },
        {
          "term": "Montante",
          "text": "capital acrescido de juros."
        }
      ],
      "duvida": {
        "quando": "inicio",
        "pergunta": "Por que o composto cresce mais depressa?",
        "resposta": "O juro de cada período vira capital do próximo: é juro sobre juro."
      },
      "lines": {
        "intro": "No simples a parcela usa C; no composto, 1 + i age sobre o saldo. Por isso as fórmulas diferem.",
        "hint": "Toque em uma marca para ver a grandeza correspondente nas barras."
      }
    }
  ],
