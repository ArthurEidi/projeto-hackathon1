    "c2": {
      "nome": "Evento B",
      "resumo": "Casas que fazem B acontecer."
    },
    "c3": {
      "nome": "Interseção",
      "resumo": "Casas comuns a A e B: os dois acontecem juntos."
    },
    "c4": {
      "nome": "Complemento",
      "resumo": "Casas fora do evento: ele não acontece."
    }
  },
