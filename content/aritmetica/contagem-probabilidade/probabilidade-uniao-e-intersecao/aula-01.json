      "definitions": [
        {
          "term": "União",
          "text": "A ou B, pelo menos um acontece."
        },
        {
          "term": "Interseção",
          "text": "A e B ao mesmo tempo."
        },
        {
          "term": "Complemento",
          "text": "P(não A) = 1 − P(A)."
        }
      ],
      "lines": {
        "intro": "Somando A e B, as casas comuns entram duas vezes. Por isso a união desconta a interseção uma vez.",
