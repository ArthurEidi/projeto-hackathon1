{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Equações Modulares",
  "subtitulo": "Duas posições, uma distância",
  "caminho": {
    "pilar": "algebra",
    "setor": "equacoes-e-inequacoes",
    "unidade": "equacoes-modulares"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Entrada x",
      "resumo": "Posição do ponto na reta."
    },
    "c2": {
      "nome": "Centro c",
      "resumo": "Referência a partir da qual medimos distância."
    },
    "c3": {
      "nome": "Distância",
      "resumo": "Comprimento entre a entrada e o centro."
    },
    "c4": {
      "nome": "Soluções",
      "resumo": "Pontos à distância pedida do centro."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "reta_numerica",
      "params": {
        "intervalo": [-5, 5],
        "marcas": 1,
        "pontos": [
          {
            "x": 0,
            "cor": "c4",
            "rotulo": "0"
          }
        ],
        "ponto": {
          "x": 1,
          "arrastavel": true,
          "passo": 1,
          "cor": "c1",
          "distanciaZero": true,
          "corDistancia": "c3"
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "lte": 0
      },
      "lines": {
        "intro": "No caso neutro ∣x∣=0, existe outro ponto além da origem? Arraste até 0.",
        "done": "Não; só a origem tem distância zero dela mesma."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Módulo também aparece em inequações e funções; aqui buscamos pontos a uma distância fixa."
      }
    },
    {
      "id": "dois-lados",
      "type": "interactive_canvas",
      "widget": "reta_numerica",
      "params": {
        "intervalo": [-5, 5],
        "marcas": 1,
        "pontos": [
          {
            "x": -2,
            "cor": "c4",
            "rotulo": "−2"
          },
          {
            "x": 2,
            "cor": "c4",
            "rotulo": "2"
          }
        ],
        "ponto": {
          "x": 0,
          "arrastavel": true,
          "passo": 1,
          "cor": "c1",
          "distanciaZero": true,
          "corDistancia": "c3"
        }
      },
      "antes_de_concluir": {
        "pontos": [
          { "x": 2, "cor": "c4", "rotulo": "2" }
        ]
      },
      "complete_when": {
        "metric": "ponto_x",
        "lte": -2
      },
      "lines": {
        "intro": "Para ∣x∣=2, o lado negativo também serve? Arraste até −2.",
        "done": "Serve; −2 e 2 ficam a duas unidades de zero."
      }
    },
    {
      "id": "mover-centro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 5],
        "y": [-1, 4],
        "curvas": [
          {
            "tipo": "modular",
            "a": 1,
            "b": 1,
            "c": 0,
            "cor": "c3",
            "rotulo": "y = |x − 1|"
          },
          {
            "tipo": "afim",
            "a": 0,
            "b": 2,
            "cor": "ink",
            "rotulo": "y = 2"
          },
          {
            "tipo": "modular",
            "a": 1,
            "b": 0,
            "c": 0,
            "fantasma": true,
            "rotulo": "y = |x|"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 1,
          "passo": 1,
          "cor": "c1"
        },
        "marcar": {
          "encontro": true
        },
        "cores": {
          "encontro": "c4"
        }
      },
      "complete_when": {
        "metric": "no_encontro",
        "gte": 1
      },
      "lines": {
        "intro": "Ao mudar o centro para 1, onde fica a solução da direita? Arraste até 3.",
        "done": "Fica em 3 porque 3−1=2; a outra é −1, por isso x=c±r."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "E se a distância pedida for −2?",
        "resposta": "Não existe solução, pois distâncias não são negativas."
      }
    },
    {
      "id": "conferir-previsao",
      "type": "micro_challenge",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-3, 5],
          "y": [-1, 4],
          "curvas": [
            {
              "tipo": "modular",
              "a": 1,
              "b": 1,
              "c": 0,
              "cor": "c3",
              "rotulo": "y = |x − 1|"
            },
            {
              "tipo": "afim",
              "a": 0,
              "b": 2,
              "cor": "ink",
              "rotulo": "y = 2"
            }
          ],
          "cores": {
            "encontro": "c4"
          }
        }
      },
      "lines": {
        "intro": "Que previsão você faz ao comparar a figura com as condições do problema?"
      },
      "prompt": "Quais soluções tem ∣x−1∣=2?",
      "options": [
        {
          "id": "micro-erro",
          "label": "1 e 3",
          "correct": false,
          "feedback": "1 é o centro, onde |x − 1| vale 0, não 2. A partir do centro, ande 2 para cada lado.",
          "figure": { "ponto": { "curva": 0, "x": 1, "cor": "c2" } }
        },
        {
          "id": "micro-acerto",
          "label": "−1 e 3",
          "correct": true,
          "feedback": "Certo: −1 e 3; 1−2=−1 e 1+2=3.",
          "figure": { "highlight": ["c4"] }
        },
        {
          "id": "so-um-caso",
          "label": "3",
          "correct": false,
          "feedback": "Você resolveu só x − 1 = 2 e perdeu o outro caso. Módulo igual a 2 vale também quando x − 1 = −2.",
          "figure": { "ponto": { "curva": 0, "x": 3, "cor": "c1" }, "highlight": ["c1"] }
        },
        {
          "id": "centro-trocado",
          "label": "−3 e 1",
          "correct": false,
          "feedback": "Você trocou o sinal do centro, como se fosse |x + 1|. O centro de |x − 1| é onde x − 1 = 0.",
          "figure": {
            "x": [-4, 5],
            "curvas": [
              { "tipo": "modular", "a": 1, "b": 1, "c": 0, "cor": "c3", "rotulo": "y = |x − 1|" },
              { "tipo": "afim", "a": 0, "b": 2, "cor": "ink", "rotulo": "y = 2" },
              { "tipo": "modular", "a": 1, "b": -1, "c": 0, "cor": "c1", "rotulo": "|x + 1|" }
            ],
            "highlight": ["c1"]
          }
        }
      ]
    },
    {
      "id": "fechamento",
      "type": "concept_lock",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-3, 5],
          "y": [-1, 4],
          "curvas": [
            {
              "tipo": "modular",
              "a": 1,
              "b": 1,
              "c": 0,
              "cor": "c3",
              "rotulo": "y = |x − 1|"
            },
            {
              "tipo": "afim",
              "a": 0,
              "b": 2,
              "cor": "ink",
              "rotulo": "y = 2"
            }
          ],
          "cores": {
            "encontro": "c4"
          }
        }
      },
      "formula": [
        {
          "text": "|"
        },
        {
          "text": "x",
          "ref": "c1"
        },
        {
          "text": " − "
        },
        {
          "text": "c",
          "ref": "c2"
        },
        {
          "text": "| = r ⇒ "
        },
        {
          "text": "x = c ± r",
          "ref": "c4"
        },
        {
          "text": ", r ≥ 0"
        }
      ],
      "definitions": [
        {
          "term": "Entrada x",
          "text": "Posição do ponto na reta."
        },
        {
          "term": "Distância",
          "text": "Comprimento entre a entrada e o centro."
        },
        {
          "term": "Soluções",
          "text": "Pontos à distância pedida do centro."
        }
      ],
      "lines": {
        "intro": "A distância mede os dois lados do centro; por isso as soluções são c−r e c+r quando r≥0.",
        "hint": "Toque em uma letra para ver o que ela faz no gráfico."
      }
    }
  ],
  "treino": {
    "faceis": [
      {
        "id": "f1-equacoes-modulares",
        "prompt": "Qual é a distância de −2 até zero?",
        "options": [
          {
            "id": "f1-equacoes-modulares-erro",
            "label": "−2",
            "correct": false,
            "feedback": "Distância não leva sinal negativo. O certo é 2; ∣−2∣=2."
          },
          {
            "id": "f1-equacoes-modulares-erro2",
            "label": "0",
            "correct": false,
            "feedback": "A distância de −2 até 0 não é nula. O certo é 2; ∣−2∣=2."
          },
          {
            "id": "f1-equacoes-modulares-certa",
            "label": "2",
            "correct": true,
            "feedback": "Certo: 2; ∣−2∣=2."
          },
          {
            "id": "f1-equacoes-modulares-erro3",
            "label": "4",
            "correct": false,
            "feedback": "Você dobrou a distância ao somar −2 com 2. O certo é 2; ∣−2∣=2."
          }
        ]
      },
      {
        "id": "f2-equacoes-modulares",
        "prompt": "Quantas soluções tem ∣x∣=0?",
        "options": [
          {
            "id": "f2-equacoes-modulares-certa",
            "label": "1",
            "correct": true,
            "feedback": "Certo: 1; x=±0=0."
          },
          {
            "id": "f2-equacoes-modulares-erro",
            "label": "2",
            "correct": false,
            "feedback": "Os dois candidatos coincidem em zero. O certo é 1; x=±0=0."
          },
          {
            "id": "f2-equacoes-modulares-erro2",
            "label": "0",
            "correct": false,
            "feedback": "O próprio zero satisfaz ∣0∣=0, logo há solução. O certo é 1; x=±0=0."
          },
          {
            "id": "f2-equacoes-modulares-erro3",
            "label": "Infinitas",
            "correct": false,
            "feedback": "Só x=0 tem distância zero até a origem. O certo é 1; x=±0=0."
          }
        ]
      },
      {
        "id": "f3-equacoes-modulares",
        "prompt": "Quais pontos ficam a 2 de zero?",
        "options": [
          {
            "id": "f3-equacoes-modulares-erro",
            "label": "0 e 2",
            "correct": false,
            "feedback": "O centro tem distância zero. O certo é −2 e 2; ∣−2∣=∣2∣=2."
          },
          {
            "id": "f3-equacoes-modulares-erro2",
            "label": "Só 2",
            "correct": false,
            "feedback": "Você esqueceu o lado negativo da reta. O certo é −2 e 2; ∣−2∣=∣2∣=2."
          },
          {
            "id": "f3-equacoes-modulares-certa",
            "label": "−2 e 2",
            "correct": true,
            "feedback": "Certo: −2 e 2; ∣−2∣=∣2∣=2."
          },
          {
            "id": "f3-equacoes-modulares-erro3",
            "label": "−2 e 0",
            "correct": false,
            "feedback": "O ponto 0 fica a distância 0 da origem, não 2. O certo é −2 e 2; ∣−2∣=∣2∣=2."
          }
        ]
      },
      {
        "id": "f4-equacoes-modulares",
        "prompt": "Em ∣x−1∣=2, qual é o centro?",
        "options": [
          {
            "id": "f4-equacoes-modulares-erro2",
            "label": "2",
            "correct": false,
            "feedback": "Você confundiu o centro com o raio 2. O certo é 1; x−1=0 em x=1."
          },
          {
            "id": "f4-equacoes-modulares-certa",
            "label": "1",
            "correct": true,
            "feedback": "Certo: 1; x−1=0 em x=1."
          },
          {
            "id": "f4-equacoes-modulares-erro",
            "label": "−1",
            "correct": false,
            "feedback": "Você trocou o sinal ao zerar x−1. O certo é 1; x−1=0 em x=1."
          },
          {
            "id": "f4-equacoes-modulares-erro3",
            "label": "0",
            "correct": false,
            "feedback": "O módulo foi deslocado para x=1, não está na origem. O certo é 1; x−1=0 em x=1."
          }
        ]
      }
    ],
    "medias": [
      {
        "id": "m1-equacoes-modulares",
        "prompt": "Resolva ∣x∣=3.",
        "options": [
          {
            "id": "m1-equacoes-modulares-erro",
