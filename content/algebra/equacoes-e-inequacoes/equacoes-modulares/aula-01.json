            "correct": false,
            "feedback": "Faltou o lado esquerdo. O certo é −3 e 3; x=±3."
          },
          {
            "id": "m1-equacoes-modulares-erro2",
            "label": "Só −3",
            "correct": false,
            "feedback": "Você pegou apenas o lado negativo. O certo é −3 e 3; x=±3."
          },
          {
            "id": "m1-equacoes-modulares-erro3",
            "label": "0 e 3",
            "correct": false,
            "feedback": "Em x=0 temos ∣0∣=0≠3. O certo é −3 e 3; x=±3."
          },
          {
            "id": "m1-equacoes-modulares-certa",
            "label": "−3 e 3",
            "correct": true,
            "feedback": "Certo: −3 e 3; x=±3."
