            "id": "m3-expressoes-algebricas-e-produtos-notaveis-erro2",
            "label": "x²−4x−4",
            "correct": false,
            "feedback": "Os termos +2x e −2x se cancelam. O certo é x²−4; 2x−2x=0; 2·(−2)=−4."
          },
          {
            "id": "m3-expressoes-algebricas-e-produtos-notaveis-certa",
            "label": "x²−4",
            "correct": true,
            "feedback": "Certo: x²−4; 2x−2x=0; 2·(−2)=−4."
          },
          {
            "id": "m3-expressoes-algebricas-e-produtos-notaveis-erro3",
            "label": "x²−2",
            "correct": false,
            "feedback": "Você esqueceu de multiplicar 2 por 2. O certo é x²−4; 2x−2x=0; 2·(−2)=−4."
          }
        ]
      }
    ],
    "desafios": [
