          {
            "id": "m3-expressoes-algebricas-e-produtos-notaveis-erro",
            "label": "x²+4",
            "correct": false,
            "feedback": "O produto das constantes tem sinal negativo. O certo é x²−4; 2x−2x=0; 2·(−2)=−4."
