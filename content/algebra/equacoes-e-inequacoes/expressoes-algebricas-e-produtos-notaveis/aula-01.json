          {
            "id": "m1-expressoes-algebricas-e-produtos-notaveis-certa",
            "label": "9",
            "correct": true,
            "feedback": "Certo: 9; 4+4+1=9."
          }
        ]
      },
      {
        "id": "m2-expressoes-algebricas-e-produtos-notaveis",
        "prompt": "Quanto vale (3−1)²?",
