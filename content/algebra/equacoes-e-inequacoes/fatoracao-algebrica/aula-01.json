  "treino": {
    "faceis": [
      {
        "id": "f1-fatoracao-algebrica",
        "prompt": "Em x(x−2), x=0 zera qual fator?",
        "options": [
          {
            "id": "f1-fatoracao-algebrica-erro",
            "label": "x−2",
            "correct": false,
            "feedback": "Você trocou os fatores. O certo é x; x=0; x−2=−2."
          },
          {
            "id": "f1-fatoracao-algebrica-erro2",
            "label": "Ambos",
            "correct": false,
            "feedback": "Em x=0 o fator x−2 vale −2, não zero. O certo é x; x=0; x−2=−2."
          },
          {
            "id": "f1-fatoracao-algebrica-certa",
            "label": "x",
            "correct": true,
            "feedback": "Certo: x; x=0; x−2=−2."
          },
          {
            "id": "f1-fatoracao-algebrica-erro3",
            "label": "Nenhum",
            "correct": false,
            "feedback": "O primeiro fator é o próprio x, que vale 0. O certo é x; x=0; x−2=−2."
          }
        ]
      },
      {
        "id": "f2-fatoracao-algebrica",
        "prompt": "Qual entrada zera x−2?",
        "options": [
          {
            "id": "f2-fatoracao-algebrica-certa",
            "label": "2",
            "correct": true,
            "feedback": "Certo: 2; 2−2=0."
          },
          {
            "id": "f2-fatoracao-algebrica-erro",
            "label": "−2",
            "correct": false,
            "feedback": "O sinal foi trocado. O certo é 2; 2−2=0."
          },
          {
            "id": "f2-fatoracao-algebrica-erro2",
            "label": "0",
            "correct": false,
            "feedback": "Em x=0 temos 0−2=−2≠0. O certo é 2; 2−2=0."
          },
          {
            "id": "f2-fatoracao-algebrica-erro3",
            "label": "1",
            "correct": false,
            "feedback": "Em x=1 temos 1−2=−1≠0. O certo é 2; 2−2=0."
          }
        ]
      },
      {
        "id": "f3-fatoracao-algebrica",
        "prompt": "Como fatorar x²−2x?",
        "options": [
          {
            "id": "f3-fatoracao-algebrica-erro",
            "label": "x(x−1)",
            "correct": false,
            "feedback": "O coeficiente 2 foi perdido. O certo é x(x−2); x·x−x·2=x²−2x."
          },
          {
            "id": "f3-fatoracao-algebrica-erro2",
            "label": "x(x+2)",
            "correct": false,
            "feedback": "Você trocou o sinal do termo −2x. O certo é x(x−2); x·x−x·2=x²−2x."
          },
          {
            "id": "f3-fatoracao-algebrica-certa",
            "label": "x(x−2)",
            "correct": true,
            "feedback": "Certo: x(x−2); x·x−x·2=x²−2x."
          },
          {
            "id": "f3-fatoracao-algebrica-erro3",
            "label": "2(x²−x)",
            "correct": false,
            "feedback": "Você colocou 2 em evidência em x², mas x² não tem fator 2. O certo é x(x−2); x·x−x·2=x²−2x."
          }
        ]
      },
      {
        "id": "f4-fatoracao-algebrica",
        "prompt": "Um produto zero exige que todos os fatores sejam zero?",
        "options": [
          {
            "id": "f4-fatoracao-algebrica-certa",
            "label": "Não",
            "correct": true,
            "feedback": "Certo: Não; 0·3=0."
          },
          {
            "id": "f4-fatoracao-algebrica-erro",
            "label": "Sim",
            "correct": false,
            "feedback": "Basta um fator nulo. O certo é Não; 0·3=0."
          }
        ]
      }
    ],
    "medias": [
      {
        "id": "m1-fatoracao-algebrica",
        "prompt": "Quais são as raízes de (x−1)(x+2)?",
        "options": [
          {
            "id": "m1-fatoracao-algebrica-erro",
            "label": "−1 e 2",
            "correct": false,
            "feedback": "Você trocou os sinais das raízes. O certo é 1 e −2; 1−1=0; −2+2=0."
          },
          {
            "id": "m1-fatoracao-algebrica-erro2",
            "label": "−1 e −2",
            "correct": false,
            "feedback": "Você manteve o sinal negativo em x−1=0. O certo é 1 e −2; 1−1=0; −2+2=0."
          },
          {
            "id": "m1-fatoracao-algebrica-certa",
            "label": "1 e −2",
            "correct": true,
            "feedback": "Certo: 1 e −2; 1−1=0; −2+2=0."
          },
          {
            "id": "m1-fatoracao-algebrica-erro3",
            "label": "1 e 2",
            "correct": false,
            "feedback": "Você esqueceu de inverter o sinal em x+2=0. O certo é 1 e −2; 1−1=0; −2+2=0."
          }
        ]
      },
      {
        "id": "m2-fatoracao-algebrica",
        "prompt": "Fatore x²−9.",
        "options": [
          {
            "id": "m2-fatoracao-algebrica-certa",
            "label": "(x−3)(x+3)",
            "correct": true,
            "feedback": "Certo: (x−3)(x+3); 9=3²."
          },
          {
            "id": "m2-fatoracao-algebrica-erro",
            "label": "(x−9)(x+9)",
            "correct": false,
            "feedback": "Você usou a área como lado. O certo é (x−3)(x+3); 9=3²."
          },
          {
            "id": "m2-fatoracao-algebrica-erro2",
            "label": "(x−3)²",
            "correct": false,
            "feedback": "A expansão (x−3)² tem termo −6x, não é x²−9. O certo é (x−3)(x+3); 9=3²."
          },
          {
            "id": "m2-fatoracao-algebrica-erro3",
            "label": "(x+3)²",
            "correct": false,
            "feedback": "O quadrado da soma expandido dá x²+6x+9, não x²−9. O certo é (x−3)(x+3); 9=3²."
          }
        ]
      },
      {
        "id": "m3-fatoracao-algebrica",
        "prompt": "Quanto vale x(x−2) em x=1?",
        "options": [
          {
            "id": "m3-fatoracao-algebrica-erro",
            "label": "1",
            "correct": false,
            "feedback": "Faltou o sinal do segundo fator. O certo é −1; 1·(1−2)=−1."
          },
          {
            "id": "m3-fatoracao-algebrica-erro2",
            "label": "0",
            "correct": false,
            "feedback": "Em x=1 nenhum dos fatores é zero. O certo é −1; 1·(1−2)=−1."
          },
          {
            "id": "m3-fatoracao-algebrica-erro3",
            "label": "−2",
            "correct": false,
            "feedback": "Você esqueceu de subtrair 1 em 1−2. O certo é −1; 1·(1−2)=−1."
          },
          {
            "id": "m3-fatoracao-algebrica-certa",
            "label": "−1",
            "correct": true,
            "feedback": "Certo: −1; 1·(1−2)=−1."
          }
        ]
      }
    ],
    "desafios": [
      {
        "id": "d1-fatoracao-algebrica",
        "prompt": "Resolver x²=2x dividindo por x perde qual solução?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d1-fatoracao-algebrica-erro2",
            "label": "−2",
            "correct": false,
            "feedback": "Em x=−2 temos (−2)²=4≠−4, não é solução. O certo é 0; x(x−2)=0; x=0 ou 2."
          },
          {
            "id": "d1-fatoracao-algebrica-certa",
            "label": "0",
            "correct": true,
            "feedback": "Certo: 0; x(x−2)=0; x=0 ou 2."
          },
          {
            "id": "d1-fatoracao-algebrica-erro",
            "label": "2",
            "correct": false,
            "feedback": "A divisão exclui x=0. O certo é 0; x(x−2)=0; x=0 ou 2."
          },
          {
            "id": "d1-fatoracao-algebrica-erro3",
            "label": "1",
            "correct": false,
            "feedback": "Em x=1 temos 1²=1≠2, não é solução. O certo é 0; x(x−2)=0; x=0 ou 2."
          }
        ]
      },
      {
        "id": "d2-fatoracao-algebrica",
        "prompt": "Quais são as raízes de 2x²−x?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d2-fatoracao-algebrica-erro",
            "label": "Só 0,5",
            "correct": false,
            "feedback": "Você cancelou x e perdeu zero. O certo é 0 e 0,5; x(2x−1)=0."
