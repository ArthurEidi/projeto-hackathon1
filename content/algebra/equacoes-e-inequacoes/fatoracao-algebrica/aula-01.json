          {
            "id": "d2-fatoracao-algebrica-erro2",
            "label": "0 e 2",
            "correct": false,
            "feedback": "Você dividiu errado: 2x−1=0 dá x=0,5, não 2. O certo é 0 e 0,5; x(2x−1)=0."
          },
          {
            "id": "d2-fatoracao-algebrica-certa",
            "label": "0 e 0,5",
            "correct": true,
            "feedback": "Certo: 0 e 0,5; x(2x−1)=0."
          },
          {
            "id": "d2-fatoracao-algebrica-erro3",
            "label": "−0,5 e 0",
            "correct": false,
            "feedback": "Você trocou o sinal ao resolver 2x−1=0. O certo é 0 e 0,5; x(2x−1)=0."
          }
        ]
      },
      {
        "id": "d3-fatoracao-algebrica",
        "prompt": "Se (x−a)(x+1) zera em x=2, qual é a?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d3-fatoracao-algebrica-certa",
            "label": "2",
            "correct": true,
            "feedback": "Certo: 2; (2−a)·3=0."
          },
          {
            "id": "d3-fatoracao-algebrica-erro",
            "label": "−1",
            "correct": false,
            "feedback": "O segundo fator vale 3, não zero. O certo é 2; (2−a)·3=0."
          },
          {
            "id": "d3-fatoracao-algebrica-erro2",
            "label": "−2",
            "correct": false,
            "feedback": "Com a=−2 o primeiro fator dá 2−(−2)=4≠0. O certo é 2; (2−a)·3=0."
          },
          {
            "id": "d3-fatoracao-algebrica-erro3",
            "label": "0",
            "correct": false,
            "feedback": "Com a=0 temos (2−0)·3=6≠0. O certo é 2; (2−a)·3=0."
          }
        ]
      },
      {
        "id": "d4-fatoracao-algebrica",
        "prompt": "Em x²+1=0 há raiz real?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d4-fatoracao-algebrica-erro",
            "label": "Sim",
            "correct": false,
            "feedback": "Um quadrado real não pode valer −1. O certo é Não; x²+1≥1."
          },
          {
            "id": "d4-fatoracao-algebrica-certa",
            "label": "Não",
            "correct": true,
            "feedback": "Certo: Não; x²+1≥1."
          }
        ]
      },
      {
        "id": "d5-fatoracao-algebrica",
        "prompt": "Um retângulo tem área x²−4 e lados positivos x−2 e x+2; se a área é 5, qual x serve?",
        "paco": "Antes de escolher, confira as condições e substitua a resposta na relação do problema.",
        "options": [
          {
            "id": "d5-fatoracao-algebrica-erro2",
            "label": "1",
            "correct": false,
            "feedback": "Em x=1 o lado x−2 vale −1, que é negativo. O certo é 3; x²=9; x>2; x=3."
          },
          {
            "id": "d5-fatoracao-algebrica-certa",
            "label": "3",
            "correct": true,
            "feedback": "Certo: 3; x²=9; x>2; x=3."
          },
          {
            "id": "d5-fatoracao-algebrica-erro",
            "label": "−3",
            "correct": false,
            "feedback": "Você aceitou um comprimento negativo. O certo é 3; x²=9; x>2; x=3."
          },
          {
            "id": "d5-fatoracao-algebrica-erro3",
            "label": "5",
            "correct": false,
            "feedback": "Com x=5 a área seria 25−4=21, não 5. O certo é 3; x²=9; x>2; x=3."
