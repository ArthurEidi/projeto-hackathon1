{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Equações com Radicais e Soluções Espúrias",
  "subtitulo": "A raiz escolhe a altura positiva",
  "caminho": {
    "pilar": "algebra",
    "setor": "equacoes-e-inequacoes",
    "unidade": "equacoes-irracionais"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Entrada x",
      "resumo": "Número testado nos dois lados."
    },
    "c2": {
      "nome": "Radicando A",
      "resumo": "Expressão dentro da raiz quadrada."
    },
    "c3": {
      "nome": "Raiz principal",
      "resumo": "Valor não negativo devolvido pela raiz."
    },
    "c4": {
      "nome": "Candidatos válidos",
      "resumo": "Candidatos que passam na equação original."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "curvas": [
          {
            "tipo": "modular",
            "a": 1,
            "b": 0,
            "c": 0,
            "cor": "c3",
            "rotulo": "√(x²)"
          },
          {
            "tipo": "afim",
            "a": 1,
            "b": 0,
            "fantasma": true,
            "rotulo": "y = x"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 0,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "lte": -1
      },
      "lines": {
        "intro": "No caso neutro com x ≥ 0, √(x²) = x; o que sai se você arrastar até −1?",
        "done": "Em x = −1 sai 1 porque a raiz principal é não negativa; √(x²) é o módulo de x."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Há vários índices de radicais; aqui tratamos raízes quadradas e conferimos candidatos depois de elevar ao quadrado."
      }
    },
    {
      "id": "encontro-valido",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 4],
        "y": [-3, 4],
        "curvas": [
          {
            "tipo": "raiz",
            "a": 1,
            "b": -2,
            "c": 0,
            "cor": "c3",
            "rotulo": "y = √(x+2)"
          },
          {
            "tipo": "afim",
            "a": 1,
            "b": 0,
            "cor": "ink",
            "rotulo": "y = x"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 0,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "no_encontro",
        "gte": 1
      },
      "lines": {
        "intro": "Qual ponto faz √(x+2) = x? Arraste até 2.",
        "done": "Em 2 os lados valem 2; como x+2=x², então os candidatos vêm de x²−x−2=0."
      }
    },
    {
      "id": "rejeitar-sinal",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 4],
        "y": [-3, 4],
        "curvas": [
          {
            "tipo": "raiz",
            "a": 1,
            "b": -2,
            "c": 0,
            "cor": "c3",
            "rotulo": "y = √(x+2)"
          },
          {
            "tipo": "afim",
            "a": 1,
            "b": 0,
            "cor": "ink",
            "rotulo": "y = x"
          }
        ],
        "ponto": {
          "curva": null,
          "x": 0,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "lte": -1
      },
      "lines": {
        "intro": "A conta ao quadrado também deu −1; ele passa no original? Arraste até −1.",
        "done": "Não; em x = −1, 1 ≠ −1, por isso elevar ao quadrado exige conferir o sinal."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Basta o radicando ser positivo?",
        "resposta": "Não; o lado igual à raiz também precisa ser não negativo."
      }
    },
    {
      "id": "conferir-previsao",
