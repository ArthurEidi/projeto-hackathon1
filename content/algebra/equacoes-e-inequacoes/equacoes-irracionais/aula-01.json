      "definitions": [
        {
          "term": "Entrada x",
          "text": "Número testado nos dois lados."
        },
        {
          "term": "Raiz principal",
          "text": "Valor não negativo devolvido pela raiz."
        },
        {
          "term": "Candidatos válidos",
          "text": "Candidatos que passam na equação original."
        }
