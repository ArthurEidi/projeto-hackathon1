{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Equações Quadráticas e Interpretação das Raízes",
  "subtitulo": "Contar encontros com o eixo",
  "caminho": {
    "pilar": "algebra",
    "setor": "equacoes-e-inequacoes",
    "unidade": "equacoes-quadraticas"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Entrada x",
      "resumo": "Coordenada horizontal da parábola."
    },
    "c2": {
      "nome": "Altura c",
      "resumo": "Deslocamento vertical da parábola."
    },
    "c3": {
      "nome": "Parábola",
      "resumo": "Altura da expressão quadrática."
    },
    "c4": {
      "nome": "Raízes",
      "resumo": "Entradas em que a parábola encontra o eixo."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-4, 4],
        "y": [-4, 4],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": "$c",
            "cor": "c3",
            "rotulo": "y = x² + c"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "fantasma": true,
            "rotulo": "y = x²"
          }
        ],
        "marcar": {
          "raizes": true
        },
        "cores": {
          "raiz": "c4"
        }
      },
      "controls": [
        {
          "id": "c",
          "label": "Altura",
          "min": -1,
          "max": 1,
          "step": 1,
          "initial": 0,
          "color": "c2"
        }
      ],
      "complete_when": {
        "metric": "c",
        "gte": 1
      },
      "lines": {
        "intro": "No caso neutro x²=0, a curva só toca o eixo; ao levar c a 1, ainda haverá encontro?",
        "done": "Não; x²+1≥1, então a saída nunca zera."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Há quadráticas completas e incompletas; aqui ligamos fatoração, quadrado completo e quantidade de raízes."
      }
    },
    {
      "id": "abrir-duas-raizes",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-4, 4],
        "y": [-4, 4],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": "$c",
            "cor": "c3",
            "rotulo": "y = x² + c"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "fantasma": true,
            "rotulo": "y = x²"
          }
        ],
        "marcar": {
          "raizes": true
        },
        "cores": {
          "raiz": "c4"
        }
      },
      "controls": [
        {
          "id": "c",
          "label": "Altura",
          "min": -1,
          "max": 1,
          "step": 1,
          "initial": 0,
          "color": "c2"
        }
      ],
      "complete_when": {
        "metric": "c",
        "lte": -1
      },
      "lines": {
        "intro": "Ao baixar c até −1, quantas raízes surgem?",
        "done": "Surgem duas: x²=1 aceita −1 e 1, porque ambos têm quadrado 1."
      }
    },
    {
      "id": "contar-pelo-discriminante",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-1, 3],
        "y": [-2, 5],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": -2,
            "c": "$c",
            "cor": "c3",
            "rotulo": "y = x² − 2x + c"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": -2,
            "c": 1,
            "fantasma": true,
            "rotulo": "y = (x − 1)²"
          }
        ],
        "marcar": {
          "raizes": true
        },
        "cores": {
          "raiz": "c4"
        }
      },
      "controls": [
        {
          "id": "c",
          "label": "Termo constante",
          "min": 0,
          "max": 2,
          "step": 1,
          "initial": 1,
          "color": "c2"
        }
      ],
      "complete_when": {
        "metric": "c",
        "lte": 0
      },
      "lines": {
        "intro": "Com x²−2x+c=(x−1)²+c−1, baixar c de 1 para 0 cria quantas raízes?",
        "done": "Cria duas: (x−1)²=1; em geral, (x+b/(2a))²=Δ/(4a²), por isso o sinal de Δ decide a quantidade."
      }
    },
    {
      "id": "deslocar-centro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-1, 3],
        "y": [-2, 5],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": -2,
            "c": 0,
            "cor": "c3",
            "rotulo": "y = x² − 2x"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": -1,
            "fantasma": true,
            "rotulo": "y = x² − 1"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 1,
          "passo": 1,
          "cor": "c1"
        },
        "marcar": {
          "raizes": true
        },
        "cores": {
          "raiz": "c4"
        }
      },
      "complete_when": {
        "metric": "na_raiz",
        "gte": 1
      },
      "lines": {
        "intro": "Em (x−1)²=1, a simetria ainda fica em zero? Arraste de 1 até 2.",
        "done": "Agora o centro é 1; como x−1=±1, então as raízes são 0 e 2."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Se o coeficiente de x² zerar?",
        "resposta": "A equação perde o grau 2; a fórmula quadrática deixa de valer."
      }
    },
    {
      "id": "conferir-previsao",
      "type": "micro_challenge",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-3, 3],
          "y": [-1, 5],
          "curvas": [
            {
              "tipo": "quadratica",
              "a": 1,
              "b": 0,
              "c": 1,
              "cor": "c3",
              "rotulo": "y = x² + 1"
            }
          ]
        }
      },
      "lines": {
        "intro": "Que previsão você faz ao comparar a figura com as condições do problema?"
      },
      "prompt": "Quantas raízes reais distintas tem x²+1=0?",
      "options": [
        {
          "id": "micro-acerto",
          "label": "Nenhuma",
          "correct": true,
          "feedback": "Certo: Nenhuma; x²+1≥1 para todo real.",
          "figure": {
            "marcar": { "vertice": true },
            "guias": { "horizontais": [{ "v": 1, "rotulo": "mín = 1", "cor": "c4" }] },
            "highlight": ["c3"]
          }
        },
        {
          "id": "micro-erro",
          "label": "Duas",
          "correct": false,
          "feedback": "±1 resolve x² = 1, não x² = −1. Pense: algum número real elevado ao quadrado dá negativo?",
          "figure": {
            "y": [-2, 5],
            "curvas": [
              { "tipo": "quadratica", "a": 1, "b": 0, "c": 1, "cor": "c3", "fantasma": true, "rotulo": "y = x² + 1" },
              { "tipo": "quadratica", "a": 1, "b": 0, "c": -1, "cor": "c4", "rotulo": "y = x² − 1" }
            ],
            "marcar": { "raizes": true },
            "highlight": ["c4"]
          }
        },
        {
          "id": "delta-sem-c",
          "label": "Uma",
          "correct": false,
          "feedback": "Você esqueceu o c no discriminante e achou Δ = 0. Refaça Δ = b² − 4ac com os três coeficientes, c = 1 incluído.",
          "figure": {
            "curvas": [
              { "tipo": "quadratica", "a": 1, "b": 0, "c": 1, "cor": "c3", "fantasma": true, "rotulo": "y = x² + 1" },
              { "tipo": "quadratica", "a": 1, "b": 0, "c": 0, "cor": "c1", "rotulo": "y = x²" }
            ],
            "marcar": { "raizes": true },
            "highlight": ["c1"]
          }
        },
        {
          "id": "contou-complexas",
          "label": "Duas: ±i",
          "correct": false,
          "feedback": "±i são raízes complexas, não reais. A pergunta conta só as raízes que a parábola marca no eixo x.",
          "figure": { "guias": { "horizontais": [{ "v": 0, "rotulo": "raízes reais", "cor": "c1" }] }, "highlight": ["c1"] }
        }
      ]
    },
    {
      "id": "fechamento",
      "type": "concept_lock",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-2, 4],
          "y": [-2, 4],
          "curvas": [
            {
              "tipo": "quadratica",
              "a": 1,
              "b": -2,
              "c": 0,
              "cor": "c3",
              "rotulo": "y = x² − 2x"
            }
          ],
          "marcar": {
            "raizes": true,
            "vertice": true
          },
          "cores": {
            "raiz": "c4",
            "vertice": "c2"
          }
        }
      },
      "formula": [
        {
          "text": "x",
          "ref": "c1"
        },
        {
          "text": " = (−b ± √Δ)/(2a); "
        },
        {
          "text": "raízes",
          "ref": "c4"
        }
      ],
      "definitions": [
        {
          "term": "Entrada x",
          "text": "Coordenada horizontal da parábola."
        },
        {
          "term": "Parábola",
          "text": "Altura da expressão quadrática."
        },
        {
          "term": "Raízes",
          "text": "Entradas em que a parábola encontra o eixo."
        }
      ],
      "lines": {
        "intro": "O quadrado completo precisa ser não negativo; Δ = b² − 4ac decide quantas raízes reais existem.",
        "hint": "Toque em uma letra para ver o que ela faz no gráfico."
      }
    }
  ],
