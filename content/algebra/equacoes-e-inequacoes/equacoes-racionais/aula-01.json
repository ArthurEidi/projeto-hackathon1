{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Equações Racionais e Restrições do Denominador",
  "subtitulo": "Conferir antes de cancelar",
  "caminho": {
    "pilar": "algebra",
    "setor": "equacoes-e-inequacoes",
    "unidade": "equacoes-racionais"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Entrada x",
      "resumo": "Número testado na equação."
    },
    "c2": {
      "nome": "Denominador D",
      "resumo": "Expressão que não pode ser zero."
    },
    "c3": {
      "nome": "Valor racional",
      "resumo": "Altura da fração onde ela existe."
    },
    "c4": {
      "nome": "Soluções válidas",
      "resumo": "Entradas do domínio que satisfazem a igualdade."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 4],
        "y": [-3, 4],
        "curvas": [
          {
            "tipo": "afim",
            "a": 1,
            "b": 0,
            "cor": "c3",
            "rotulo": "x/1"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 0,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "gte": 2
      },
      "lines": {
        "intro": "No caso neutro x/1, há alguma entrada proibida? Arraste até 2.",
        "done": "Não; o denominador 1 nunca zera."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Equações racionais podem virar polinomiais; aqui preservamos as restrições antes de multiplicar ou cancelar."
      }
    },
    {
      "id": "encontrar-fracao",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-2, 4],
        "y": [-3, 4],
        "curvas": [
          {
            "tipo": "racional",
            "a": 1,
            "b": 1,
            "c": 0,
            "cor": "c3",
            "rotulo": "1/(x−1)"
          },
          {
            "tipo": "afim",
            "a": 0,
            "b": 1,
            "cor": "ink",
            "rotulo": "y = 1"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 0,
          "passo": 1
        },
        "marcar": {
          "encontro": true,
          "assintota": true
        },
        "cores": {
          "encontro": "c4"
        }
      },
      "complete_when": {
        "metric": "no_encontro",
        "gte": 1
      },
      "lines": {
        "intro": "Onde 1/(x−1)=1? Atravesse o ponto proibido e procure o encontro em x=2.",
        "done": "Em 2, 1/(2−1)=1; multiplicar por x−1 é válido porque ele não é zero."
      }
    },
    {
      "id": "candidato-proibido",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-2, 4],
        "y": [-1, 5],
        "curvas": [
          {
            "tipo": "afim",
            "a": 1,
            "b": 1,
            "furos": [1],
            "cor": "c3",
            "rotulo": "(x²−1)/(x−1)"
          },
          {
            "tipo": "afim",
            "a": 1,
            "b": 1,
            "fantasma": true,
            "rotulo": "x+1"
          },
          {
            "tipo": "afim",
            "a": 0,
            "b": 2,
            "cor": "ink",
            "rotulo": "y = 2"
          }
        ],
        "ponto": {
          "curva": null,
          "x": 0,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "gte": 1
      },
      "lines": {
        "intro": "A reta reduzida encontra y=2 em 1; esse ponto resolve o original? Leve o cursor até lá.",
        "done": "Não; em 1 o denominador é zero, por isso o encontro da reta reduzida deve ser descartado."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Cancelar o fator preenche o furo?",
        "resposta": "Não; o domínio continua excluindo x=1."
      }
    },
