      "prompt": "Qual é a solução de (x²−1)/(x−1)=2?",
      "options": [
        {
          "id": "micro-erro",
          "label": "{1}",
          "correct": false,
          "feedback": "Em x = 1 o denominador x − 1 vale 0, e a divisão não existe ali. Antes de aceitar um candidato, confira a condição x ≠ 1.",
          "figure": { "ponto": { "curva": 1, "x": 1, "cor": "c1" } }
        },
        {
          "id": "cortou-o-1",
          "label": "{2}",
          "correct": false,
          "feedback": "Você cortou o −1 de cima com o de baixo, e isso não vale em soma. Em x = 2 a fração dá 3/1 = 3, não 2.",
          "figure": {
            "curvas": [
              { "tipo": "afim", "a": 1, "b": 1, "furos": [1], "cor": "c3", "rotulo": "(x²−1)/(x−1)" },
