            ],
            "ponto": { "curva": 2, "x": 2, "cor": "c1" }
          }
        },
        {
          "id": "ignorou-denominador",
          "label": "{±√3}",
          "correct": false,
          "feedback": "Você ignorou o denominador e resolveu x² − 1 = 2. Simplifique a fração ou multiplique os dois lados por x − 1.",
          "figure": {
            "curvas": [
              { "tipo": "afim", "a": 1, "b": 1, "furos": [1], "cor": "c3", "rotulo": "(x²−1)/(x−1)" },
              { "tipo": "afim", "a": 0, "b": 2, "cor": "ink", "rotulo": "y = 2" },
              { "tipo": "quadratica", "a": 1, "b": 0, "c": -1, "cor": "c1", "rotulo": "y = x² − 1" }
