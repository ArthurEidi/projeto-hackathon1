      "formula": [
        {
          "text": "N(x)/"
        },
        {
          "text": "D(x)",
          "ref": "c2"
        },
        {
          "text": "=k ⇔ N(x)=kD(x), D(x)≠0"
        }
      ],
      "definitions": [
        {
          "term": "Entrada x",
          "text": "Número testado na equação."
        },
        {
          "term": "Valor racional",
          "text": "Altura da fração onde ela existe."
        },
        {
          "term": "Soluções válidas",
          "text": "Entradas do domínio que satisfazem a igualdade."
        }
