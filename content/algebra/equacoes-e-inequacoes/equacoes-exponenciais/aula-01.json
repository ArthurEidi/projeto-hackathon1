{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Equações Exponenciais",
  "subtitulo": "A altura revela o expoente",
  "caminho": {
    "pilar": "algebra",
    "setor": "equacoes-e-inequacoes",
    "unidade": "equacoes-exponenciais"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Expoente x",
      "resumo": "Número que controla quantas vezes a escala atua."
    },
    "c2": {
      "nome": "Base b",
      "resumo": "Fator aplicado em cada avanço de uma unidade."
    },
    "c3": {
      "nome": "Potência",
      "resumo": "Altura produzida pela exponencial."
    },
    "c4": {
      "nome": "Solução",
      "resumo": "Expoente que atinge a altura pedida."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-2, 4],
        "y": [0, 17],
        "curvas": [
          {
            "tipo": "exponencial",
            "a": 1,
            "b": 2,
            "c": 0,
            "cor": "c3",
            "rotulo": "y = 2ˣ"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 0,
          "passo": 1,
          "cor": "c1"
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "gte": 2
      },
      "lines": {
        "intro": "No caso neutro x=0 a saída é 1; quanto sai após dois passos? Arraste até 2.",
        "done": "Sai 4 porque cada passo multiplica por 2: 1·2·2=4."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Equações exponenciais podem exigir logaritmos; aqui usamos bases iguais e substituições simples."
      }
    },
    {
      "id": "mesma-altura",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-2, 4],
