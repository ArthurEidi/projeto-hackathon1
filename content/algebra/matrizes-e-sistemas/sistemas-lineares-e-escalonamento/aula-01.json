{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Sistemas lineares, classificação e escalonamento",
  "subtitulo": "Eliminar sem perder soluções",
  "caminho": {
    "pilar": "algebra",
    "setor": "matrizes-e-sistemas",
    "unidade": "sistemas-lineares-e-escalonamento"
  },
  "outro": "Você comparou o caso neutro, testou as fronteiras e ligou o desenho à regra.",
  "glossario": {
    "c1": {
      "nome": "Par solução",
      "resumo": "Valores que atendem a todas as equações."
    },
    "c2": {
      "nome": "Multiplicador k",
      "resumo": "Número de cópias de uma linha que retiramos."
    },
    "c3": {
      "nome": "Equações",
      "resumo": "Condições simultâneas antes e depois da operação."
    },
    "c4": {
      "nome": "Pivôs e classificação",
      "resumo": "Marcas que revelam solução única, livre ou impossível."
    }
  },
  "steps": [
    {
      "id": "caso-neutro",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-2, 5],
        "y": [-2, 6],
        "curvas": [
          {
            "tipo": "afim",
            "a": -1,
            "b": 3,
            "cor": "c3",
            "rotulo": "x + y = 3"
          },
          {
            "tipo": "afim",
            "a": -2,
            "b": 4,
            "cor": "ink",
            "rotulo": "2x + y = 4"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 0,
          "passo": 1,
          "cor": "c1"
        },
        "marcar": {
          "encontro": true
        },
        "cores": {
          "encontro": "c1"
        }
      },
      "complete_when": {
        "metric": "no_encontro",
        "gte": 1
      },
      "lines": {
        "intro": "No caso neutro, as linhas ainda não mudaram; onde x+y=3 e 2x+y=4 se encontram?",
        "done": "Em (1;2), pois 1+2=3 e 2·1+2=4."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Esse assunto tem outras versões?",
        "resposta": "Sistemas podem ter mais incógnitas; aqui escalonamos 2×2 e 3×3 e classificamos pivôs, contradições e variáveis livres."
      }
    },
    {
      "id": "eliminar-linha",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "controls": [
        {
          "id": "k",
          "label": "Múltiplo retirado k",
          "min": 0,
          "max": 2,
          "step": 1,
          "initial": 0,
          "color": "c2"
        }
      ],
      "params": {
        "x": [-2, 5],
        "y": [-2, 6],
        "curvas": [
          {
            "tipo": "afim",
            "a": -1,
            "b": 3,
            "cor": "c3",
            "rotulo": "x + y = 3"
          },
          {
            "tipo": "afim",
            "a": -2,
            "b": 4,
            "fantasma": true,
            "rotulo": "2x + y = 4"
          },
          {
            "tipo": "afim",
            "a": 0,
            "b": 2,
            "cor": "c4",
            "rotulo": "y = 2"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 1,
          "arrastavel": false,
          "cor": "c1"
        }
      },
      "complete_when": {
        "metric": "k",
        "gte": 2
      },
      "lines": {
        "intro": "Ao retirar duas vezes L₁ de L₂, x some sem mudar o encontro? Leve k a 2.",
        "done": "Sim; sobra −y=−2, então y=2 e x=1; por isso eliminar conserva a solução."
      }
    },
    {
      "id": "subir-tres-linhas",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "controls": [
        {
          "id": "t",
          "label": "Valor de z",
          "min": 0,
          "max": 1,
          "step": 1,
          "initial": 0,
          "color": "ink"
        }
      ],
      "params": {
        "x": [-1, 4],
        "y": [-1, 4],
        "curvas": [
          {
            "tipo": "afim",
            "a": -1,
            "b": 2,
            "cor": "c3",
            "rotulo": "y + z = 2"
          },
          {
            "tipo": "afim",
            "a": 0,
            "b": 1,
            "cor": "c4",
            "rotulo": "z = 1"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": 1,
          "arrastavel": false,
          "cor": "c1"
        }
      },
      "complete_when": {
        "metric": "t",
        "gte": 1
      },
      "lines": {
        "intro": "No sistema triangular, se z passar de 0 para 1, quais valores sobram para y e x?",
        "done": "Ficam y=1 e x=1; começamos pela última linha, por isso cada substituição usa um valor já conhecido."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "E se a última linha fosse 0=0?",
        "resposta": "z ficaria livre; então y=2−z e x=1, com infinitas soluções."
      }
    },
    {
      "id": "classificar-linha",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "controls": [
        {
          "id": "t",
          "label": "Deslocamento",
          "min": 0,
          "max": 1,
          "step": 1,
          "initial": 0,
          "color": "ink"
        }
      ],
      "params": {
        "x": [-2, 5],
        "y": [-2, 6],
        "curvas": [
          {
            "tipo": "afim",
            "a": -1,
            "b": 2,
            "cor": "c3",
            "rotulo": "x + y = 2"
          },
          {
            "tipo": "afim",
            "a": -1,
            "b": 2.5,
            "cor": "c4",
            "rotulo": "2x + 2y = 5"
          }
        ]
      },
      "complete_when": {
        "metric": "t",
        "gte": 1
      },
      "lines": {
        "intro": "Se a última coluna ganhar 1, a linha 0=0 continua compatível? Leve t a 1.",
        "done": "Não; 0=1 é impossível, por isso o sistema deixa de ter infinitas soluções e fica sem solução."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Posso multiplicar uma linha por zero?",
        "resposta": "Não como operação equivalente; isso apagaria uma condição do sistema."
      }
    },
    {
      "id": "conferir-previsao",
      "type": "micro_challenge",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-2, 5],
          "y": [-2, 6],
          "curvas": [
            {
              "tipo": "afim",
              "a": -1,
              "b": 2,
              "cor": "c3",
              "rotulo": "x + y = 2"
            },
            {
              "tipo": "afim",
              "a": -1,
              "b": 2.5,
              "cor": "c4",
              "rotulo": "2x + 2y = 5"
            }
          ]
        }
      },
      "lines": {
        "intro": "Que previsão você faz ao comparar a figura com as condições do problema?"
      },
      "prompt": "Após escalonar, aparece 0x+0y=1; quantas soluções há?",
      "options": [
        {
          "id": "micro-erro",
          "label": "Infinitas",
          "correct": false,
          "feedback": "Você confundiu 0=1 com 0=0; a contradição dá nenhuma solução."
        },
        {
          "id": "micro-acerto",
          "label": "Nenhuma",
          "correct": true,
          "feedback": "Certo: Nenhuma; Zero nunca é igual a 1."
        }
      ]
    },
    {
      "id": "fechamento",
      "type": "concept_lock",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-2, 5],
          "y": [-2, 6],
          "curvas": [
            {
              "tipo": "afim",
              "a": -1,
              "b": 3,
              "cor": "c3",
              "rotulo": "x + y = 3"
            },
            {
              "tipo": "afim",
              "a": -2,
              "b": 4,
              "cor": "ink",
              "rotulo": "2x + y = 4"
            },
            {
              "tipo": "afim",
              "a": 0,
              "b": 2,
              "cor": "c4",
              "rotulo": "y = 2"
            }
          ],
          "ponto": {
            "curva": 0,
            "x": 1,
            "cor": "c1"
          },
          "marcar": {
            "encontro": true
          }
        }
      },
      "formula": [
        {
          "text": "L₂",
          "ref": "c3"
        },
        {
          "text": " ← L₂ − "
        },
        {
          "text": "k",
          "ref": "c2"
        },
        {
          "text": " · L₁; 0 = 0: livre; "
        },
        {
          "text": "0 = c: impossível",
          "ref": "c4"
        }
      ],
      "definitions": [
        {
          "term": "Par solução",
          "text": "Valores que atendem a todas as equações."
        },
        {
          "term": "Equações",
          "text": "Condições simultâneas antes e depois da operação."
        },
        {
          "term": "Pivôs e classificação",
          "text": "Marcas que revelam solução única, livre ou impossível."
        }
      ],
      "lines": {
        "intro": "As operações reversíveis conservam as soluções; por isso pivôs e linhas nulas revelam a classificação.",
        "hint": "Toque em uma letra para ver o que ela faz no gráfico."
      }
    }
  ],
