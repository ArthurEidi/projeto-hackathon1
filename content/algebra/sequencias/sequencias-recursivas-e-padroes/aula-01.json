          {
            "id": "o1",
            "label": "1",
            "correct": true,
            "feedback": "Certo. 16 → 8 → 4 → 2 → 1."
          },
          {
            "id": "o4",
            "label": "1/2",
            "correct": false,
            "feedback": "1/2 já é o sexto termo (a₆). Com quatro divisões chegamos a a₅ = 1."
          }
        ]
      },
      {
        "id": "sequencias-recursivas-e-padroes-m3",
        "prompt": "a₁ = 2 e aₙ = 2·aₙ₋₁ + 1. Qual é a₄?",
