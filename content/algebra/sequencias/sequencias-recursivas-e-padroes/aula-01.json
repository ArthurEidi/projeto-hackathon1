          {
            "id": "o4",
            "label": "22",
            "correct": false,
            "feedback": "Você dobrou 11 e esqueceu de somar 1. O certo é 2·11 + 1 = 23."
          },
          {
            "id": "o1",
            "label": "23",
            "correct": true,
            "feedback": "Certo. 2 → 5 → 11 → 23."
          }
        ]
      }
    ],
