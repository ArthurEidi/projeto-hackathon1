            "a1": 16,
            "d": 0,
            "acumular": true,
            "n": 5
          }
        },
        {
          "id": "somou-extremos",
          "label": "16",
          "correct": false,
          "feedback": "16 é apenas a soma dos extremos (2 + 14). Falta multiplicar pelo número de termos e dividir por 2.",
