{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Termos em Pilha",
  "subtitulo": "Somatórios de PA e PG",
  "caminho": {
    "pilar": "algebra",
    "setor": "sequencias",
    "unidade": "somatorios-pa-pg"
  },
  "outro": "Você acumulou termos sem perder parcelas; o pareamento simplifica a PA e a PG cresce por fator.",
  "glossario": {
    "c1": {
      "nome": "Quantidade n",
      "resumo": "Número de parcelas acumuladas."
    },
    "c2": {
      "nome": "Termo aₙ",
      "resumo": "Parcela na posição n."
    },
    "c3": {
      "nome": "Soma Sₙ",
      "resumo": "Total dos primeiros n termos."
    },
    "c4": {
      "nome": "Razão q",
      "resumo": "Fator entre termos da PG."
    }
  },
