        "options": [
          { "id": "a", "label": "2 · 128", "correct": false, "feedback": "2 · 128 = 256 multiplica o total de tenistas em vez de dividir aos pares. O certo é 64 + 32 + 16 + 8 + 4 + 2 + 1." },
