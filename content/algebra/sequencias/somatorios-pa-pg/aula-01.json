          },
          {
            "id": "o1",
            "label": "24",
            "correct": true,
            "feedback": "Certo. 3 + 5 + 7 + 9 = 24."
          }
        ]
      },
      {
        "id": "somatorios-pa-pg-m2",
        "prompt": "Na PG com a₁ = 3 e q = 2, quanto vale S₃?",
        "options": [
          {
            "id": "o1",
            "label": "21",
