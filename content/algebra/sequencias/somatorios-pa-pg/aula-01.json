            "acumular": true,
            "n": 4
          }
        },
        {
          "id": "esqueceu-dividir-dois",
          "label": "80",
          "correct": false,
          "feedback": "80 é 5 · (2 + 14) sem dividir por 2. Cada par de extremos entra duas vezes nessa conta; falta a metade.",
