      },
      "complete_when": {
        "metric": "n",
        "gte": 4
      }
    },
    {
      "id": "teste-de-fronteira",
      "type": "interactive_canvas",
      "widget": "barras",
      "params": {
        "modo": "sequencia",
        "casas": 0,
        "acumular": true,
        "nome": "a",
        "regra": "pg",
        "a1": 3,
        "q": 1,
        "termos": 6,
        "n": "$n"
      },
      "controls": [
        {
          "id": "n",
          "label": "Parcelas",
          "min": 1,
          "max": 6,
          "step": 1,
          "initial": 1,
          "color": "c1"
        }
      ],
      "lines": {
        "intro": "Com q = 1, todos os termos são iguais; a fórmula com divisor 1 − q ainda funciona? Avance até n = 5.",
        "done": "Não: 1 − q vale zero. Com q = 1 cada termo é a₁, então Sₙ = n·a₁: 3, 6, 9, 12, 15."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "E se q for zero?",
        "resposta": "Só o a₁ é diferente de zero, então Sₙ = a₁ para qualquer n."
      },
      "complete_when": {
        "metric": "n",
        "gte": 5
      }
    },
    {
      "id": "micro-desafio",
      "type": "micro_challenge",
      "figure": {
