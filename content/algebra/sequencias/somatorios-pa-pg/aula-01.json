        "widget": "barras_figura",
        "params": {
          "modo": "sequencia",
          "casas": 0,
          "acumular": true,
          "nome": "a",
          "regra": "pa",
          "a1": 2,
          "d": 3,
          "termos": 5,
          "n": 5
        }
      },
      "formula": [
        {
          "text": "Sₙ",
          "ref": "c3"
        },
        {
          "text": "(PA) ="
        },
        {
          "text": "n",
          "ref": "c1"
        },
        {
          "text": "(a₁ +"
        },
        {
          "text": "aₙ",
          "ref": "c2"
        },
        {
          "text": ") ÷ 2"
        },
        {
          "text": "|"
        },
        {
          "text": "Sₙ",
          "ref": "c3"
        },
        {
          "text": "(PG) = a₁(1 −"
        },
        {
          "text": "q",
          "sup": "n",
          "ref": "c4"
        },
        {
          "text": ") ÷ (1 −"
        },
        {
          "text": "q",
          "ref": "c4"
        },
        {
          "text": "), q ≠ 1"
        }
      ],
      "definitions": [
        {
          "term": "Sₙ",
          "text": "soma dos n primeiros termos."
        },
        {
          "term": "PA",
          "text": "diferença constante entre vizinhos."
        },
        {
          "term": "PG com q = 1",
          "text": "usa Sₙ = n·a₁."
        }
      ],
      "duvida": {
        "quando": "inicio",
        "pergunta": "Por que parear os extremos funciona?",
        "resposta": "Cada par de extremos soma o mesmo valor, a₁ + aₙ, e há n/2 pares. Daí Sₙ = n(a₁ + aₙ) ÷ 2."
      },
      "lines": {
        "intro": "Na PA, parear extremos simplifica a soma. Na PG, cada termo é gerado pelo fator q.",
        "hint": "Toque em uma marca para ver a grandeza correspondente nas barras."
      }
    }
  ],
