          },
          {
            "id": "f3-transformacoes-graficos-de-funcoes-e3",
            "label": "Translação para baixo",
            "correct": false,
            "feedback": "−f(x) multiplica a saída por −1, não subtrai constante. É Reflexão no eixo x."
