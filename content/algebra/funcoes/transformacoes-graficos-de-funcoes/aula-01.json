{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Translações, Reflexões e Escalas de Gráficos",
  "subtitulo": "Transformações de gráficos de funções",
  "caminho": {
    "pilar": "algebra",
    "setor": "funcoes",
    "unidade": "transformacoes-graficos-de-funcoes"
  },
  "outro": "Você testou a entrada e a fronteira; por isso g(x)=a·f(b(x−h))+k.",
  "glossario": {
    "c1": {
      "nome": "Entrada x",
      "resumo": "Coordenada horizontal percorrida na curva transformada."
    },
    "c2": {
      "nome": "Saída g(x)",
      "resumo": "Coordenada vertical após escala e deslocamentos."
    },
    "c3": {
      "nome": "Deslocamento h",
      "resumo": "Move a curva horizontalmente por meio de x−h."
    },
    "c4": {
      "nome": "Escala a",
      "resumo": "Módulo muda alturas; sinal negativo reflete no eixo x."
    }
  },
  "steps": [
    {
      "id": "curva-neutra",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 3],
        "y": [-1, 9],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "fantasma": true,
            "rotulo": "f(x) = x²"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "cor": "c2",
            "rotulo": "g(x) = x²"
          }
        ],
        "ponto": {
          "curva": 1,
          "x": 0,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "gte": 2
      },
      "lines": {
        "intro": "Que saída prevê no caso neutro? g(x)=f(x); as curvas coincidem?",
        "done": "Com fatores 1 e deslocamentos zero, a curva não se altera."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Toda transformação preserva o domínio?",
        "resposta": "Não; as entradas ainda precisam ser aceitas pela função original."
      }
    },
    {
      "id": "transladar",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "controls": [
        {
          "id": "h",
          "label": "h",
          "min": -2,
          "max": 2,
          "step": 1,
          "initial": 0
        },
        {
          "id": "k",
          "label": "k",
          "min": -2,
          "max": 2,
          "step": 1,
          "initial": 0
        }
      ],
      "params": {
        "x": [-4, 4],
        "y": [-2, 8],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "fantasma": true,
            "rotulo": "x²"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "transforma": {
              "a": 1,
              "b": 1,
              "h": "$h",
              "k": "$k"
            },
            "cor": "c3",
            "rotulo": "(x−h)²+k"
          }
        ],
        "marcar": {
          "vertice": true
        }
      },
      "complete_when": {
        "metric": "parametros_testados",
        "gte": 2
      },
      "lines": {
        "intro": "Para onde vai o vértice ao alterar h e k?",
        "done": "h positivo move para a direita e k positivo move para cima."
      }
    },
    {
      "id": "refletir-escalar",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "controls": [
        {
          "id": "a",
          "label": "a",
          "min": -3,
          "max": 3,
          "step": 1,
          "initial": 1
        }
      ],
      "params": {
        "x": [-3, 3],
        "y": [-6, 6],
        "curvas": [
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "fantasma": true,
            "rotulo": "x²"
          },
          {
            "tipo": "quadratica",
            "a": 1,
            "b": 0,
            "c": 0,
            "transforma": {
              "a": "$a",
              "b": 1,
              "h": 0,
              "k": 0
            },
            "cor": "c4",
            "rotulo": "a·x²"
          }
        ],
        "marcar": {
          "vertice": true
        }
      },
      "complete_when": {
        "metric": "a",
        "lte": -1
      },
      "lines": {
        "intro": "O que faz o sinal negativo diante de f?",
        "done": "O sinal negativo reflete no eixo x e |a| maior que 1 estica a distância vertical."
      }
    },
    {
      "id": "desafio-fronteira",
      "type": "micro_challenge",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-3, 4],
          "y": [-3, 4],
          "curvas": [
            {
              "tipo": "quadratica",
              "a": 1,
              "b": 0,
              "c": 0,
              "fantasma": true,
              "rotulo": "x²"
            },
            {
              "tipo": "quadratica",
              "a": 1,
              "b": 0,
              "c": 0,
              "transforma": {
                "a": -1,
                "b": 1,
                "h": 1,
                "k": 2
              },
              "cor": "c3",
              "rotulo": "−(x−1)²+2"
            }
          ],
          "marcar": {
            "vertice": false
          }
        }
      },
      "lines": {
        "intro": "Qual resposta a figura sustenta?"
      },
      "prompt": "Onde vai o vértice de y=x² após g(x)=−f(x−1)+2?",
      "duvida": {
        "quando": "fim",
        "pergunta": "E se a entrada estiver na fronteira?",
        "resposta": "A condição do domínio decide se o ponto entra e qual regra vale."
      },
      "options": [
        {
          "id": "certa",
          "label": "(1;2)",
          "correct": true,
          "feedback": "O vértice (0;0) vai 1 à direita e 2 para cima: (1;2).",
          "figure": { "ponto": { "curva": 1, "x": 1, "cor": "c4" } }
        },
        {
          "id": "sentidos-trocados",
          "label": "(−1;−2)",
          "correct": false,
          "feedback": "Os dois sentidos saíram trocados. Lembre: f(x − h) anda h para a direita, e somar k fora sobe k.",
          "figure": {
            "y": [-5, 4],
            "curvas": [
              { "tipo": "quadratica", "a": 1, "b": 0, "c": 0, "fantasma": true, "rotulo": "x²" },
              {
                "tipo": "quadratica",
                "a": 1,
                "b": 0,
                "c": 0,
                "transforma": { "a": -1, "b": 1, "h": 1, "k": 2 },
                "cor": "c3"
              },
              {
                "tipo": "quadratica",
                "a": 1,
                "b": 0,
                "c": 0,
                "transforma": { "a": -1, "b": 1, "h": -1, "k": -2 },
                "cor": "c1",
                "rotulo": "−(x+1)²−2"
              }
            ],
            "highlight": ["c1"]
          }
        },
        {
          "id": "refletiu-o-k",
          "label": "(1;−2)",
          "correct": false,
          "feedback": "Você deixou o menos da frente agir também sobre o termo de fora. Ele reflete só f(x − 1); o que vem somado depois não é refletido.",
          "figure": {
            "y": [-5, 4],
            "curvas": [
              { "tipo": "quadratica", "a": 1, "b": 0, "c": 0, "fantasma": true, "rotulo": "x²" },
              {
                "tipo": "quadratica",
                "a": 1,
                "b": 0,
                "c": 0,
                "transforma": { "a": -1, "b": 1, "h": 1, "k": 2 },
                "cor": "c3"
              },
              {
                "tipo": "quadratica",
                "a": 1,
                "b": 0,
                "c": 0,
                "transforma": { "a": -1, "b": 1, "h": 1, "k": -2 },
                "cor": "c4",
                "rotulo": "−(x−1)²−2"
              }
            ],
            "highlight": ["c4"]
          }
        },
        {
          "id": "sinal-de-h",
          "label": "(−1;2)",
          "correct": false,
          "feedback": "Você trocou o sentido horizontal: f(x − 1) não anda para a esquerda. Teste: qual x deixa x − 1 igual a 0?",
          "figure": {
            "curvas": [
              { "tipo": "quadratica", "a": 1, "b": 0, "c": 0, "fantasma": true, "rotulo": "x²" },
              {
                "tipo": "quadratica",
                "a": 1,
                "b": 0,
                "c": 0,
                "transforma": { "a": -1, "b": 1, "h": 1, "k": 2 },
                "cor": "c3"
              },
              {
                "tipo": "quadratica",
                "a": 1,
                "b": 0,
                "c": 0,
                "transforma": { "a": -1, "b": 1, "h": -1, "k": 2 },
                "cor": "c1",
                "rotulo": "−(x+1)²+2"
              }
            ],
            "highlight": ["c1"]
          }
        }
      ]
    },
    {
      "id": "fechamento",
      "type": "concept_lock",
      "figure": {
        "widget": "plano_figura",
        "params": {
          "x": [-3, 4],
          "y": [-4, 5],
          "curvas": [
            {
              "tipo": "quadratica",
              "a": 1,
              "b": 0,
              "c": 0,
              "fantasma": true,
              "rotulo": "x²"
            },
            {
              "tipo": "quadratica",
              "a": 1,
              "b": 0,
              "c": 0,
              "transforma": {
                "a": -2,
                "b": 1,
                "h": 1,
                "k": 3
              },
              "cor": "c2",
              "rotulo": "−2(x−1)²+3"
            }
          ],
          "marcar": {
            "vertice": false
          }
        }
      },
      "formula": [
        {
          "text": "g(x)",
          "ref": "c2"
        },
        {
          "text": " = "
        },
        {
          "text": "a",
          "ref": "c4"
        },
        {
          "text": " · f(b(x − "
        },
        {
          "text": "h",
          "ref": "c3"
        },
        {
          "text": ")) + k"
        }
      ],
      "definitions": [
        {
          "term": "Deslocamentos h, k",
          "text": "Transladam a curva horizontal e verticalmente."
        },
        {
          "term": "Fator a",
          "text": "Sinal reflete no eixo x; módulo escala alturas."
        },
        {
          "term": "Fator b",
          "text": "Sinal reflete no eixo y; módulo escala larguras."
        }
      ],
      "lines": {
        "intro": "Como a figura explica a regra? Por isso g(x)=a·f(b(x−h))+k.",
        "hint": "Toque em uma marca para ver o que ela representa no gráfico."
      },
      "duvida": {
        "quando": "inicio",
        "pergunta": "O desenho vale fora do domínio?",
        "resposta": "Não; as condições da função limitam as entradas válidas."
      }
    }
  ],
  "treino": {
    "faceis": [
      {
        "id": "f1-transformacoes-graficos-de-funcoes",
        "prompt": "Se g=f+2, para onde move a curva?",
