{
  "id": "aula-01",
  "numero": 1,
  "titulo": "Função Definida por Sentenças e Gráficos",
  "subtitulo": "Função definida por partes",
  "caminho": {
    "pilar": "algebra",
    "setor": "funcoes",
    "unidade": "funcao-definida-por-partes"
  },
  "outro": "Você testou a entrada e a fronteira; por isso f(x)=regra do trecho que contém x.",
  "glossario": {
    "c1": {
      "nome": "Entrada x",
      "resumo": "Valor que seleciona o intervalo e a sentença ativa."
    },
    "c2": {
      "nome": "Saída f(x)",
      "resumo": "Resultado calculado pela regra do trecho escolhido."
    },
    "c3": {
      "nome": "Trecho ativo",
      "resumo": "Sentença aplicada à entrada no intervalo indicado."
    },
    "c4": {
      "nome": "Fronteira",
      "resumo": "Extremo aberto ou fechado decide a inclusão da entrada."
    }
  },
  "steps": [
    {
      "id": "regra-unica",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 3],
        "y": [-3, 3],
        "curvas": [
          {
            "tipo": "afim",
            "a": 1,
            "b": 0,
            "cor": "c3",
            "rotulo": "y = x"
          }
        ],
        "ponto": {
          "curva": 0,
          "x": -1,
          "passo": 1
        }
      },
      "complete_when": {
        "metric": "ponto_x",
        "gte": 1
      },
      "lines": {
        "intro": "Que saída prevê no caso neutro? f(x)=x em R; uma regra vale para todo x?",
        "done": "Sem fronteira, uma regra transforma qualquer entrada."
      },
      "duvida": {
        "quando": "fim",
        "pergunta": "Qual regra vale exatamente na fronteira?",
        "resposta": "A condição com extremo fechado decide."
      }
    },
    {
      "id": "trocar-trecho",
      "type": "interactive_canvas",
      "widget": "plano_cartesiano",
      "params": {
        "x": [-3, 3],
        "y": [-3, 4],
        "curvas": [
          {
            "tipo": "afim",
            "a": 1,
            "b": 0,
            "dominio": {
              "de": null,
              "ate": 0,
              "abreDe": false,
              "abreAte": true
            },
            "cor": "c3",
            "rotulo": "x"
          },
          {
            "tipo": "afim",
            "a": 2,
            "b": 0,
            "dominio": {
              "de": 0,
              "ate": null,
              "abreDe": false,
