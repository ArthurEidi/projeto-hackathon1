          {
            "id": "f3-funcao-definida-por-partes-e",
            "label": "−4",
            "correct": false,
            "feedback": "Resposta: −2; Usa 2x fora do intervalo; conferência: −2<0; f(−2)=−2."
          },
          {
            "id": "f3-funcao-definida-por-partes-c",
            "label": "−2",
            "correct": true,
            "feedback": "Certo: resposta −2; conferência: −2<0; f(−2)=−2."
          }
        ]
      },
      {
        "id": "f4-funcao-definida-por-partes",
        "prompt": "Qual sentença vale em x=0 se condição é x≥0?",
