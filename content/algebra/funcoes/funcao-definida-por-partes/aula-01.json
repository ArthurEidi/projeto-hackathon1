          {
            "id": "f1-funcao-definida-por-partes-e",
            "label": "4",
            "correct": false,
            "feedback": "Resposta: 2; Aplica quadrado em vez da identidade; conferência: f(2)=2."
          },
          {
            "id": "f1-funcao-definida-por-partes-c",
            "label": "2",
            "correct": true,
            "feedback": "Certo: resposta 2; conferência: f(2)=2."
          }
        ]
      },
      {
        "id": "f2-funcao-definida-por-partes",
        "prompt": "x se x<0; 2x se x≥0. f(1)?",
        "options": [
          {
            "id": "f2-funcao-definida-por-partes-e",
            "label": "1",
            "correct": false,
            "feedback": "Resposta: 2; Usa trecho de x<0 para entrada positiva; conferência: 1≥0; 2·1=2."
          },
          {
            "id": "f2-funcao-definida-por-partes-c",
            "label": "2",
            "correct": true,
            "feedback": "Certo: resposta 2; conferência: 1≥0; 2·1=2."
          }
        ]
      },
      {
        "id": "f3-funcao-definida-por-partes",
        "prompt": "Mesma regra, f(−2)?",
