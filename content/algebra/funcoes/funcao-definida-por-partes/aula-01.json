          {
            "id": "f4-funcao-definida-por-partes-e",
            "label": "x<0",
            "correct": false,
            "feedback": "Resposta: x≥0; Trata extremo fechado como aberto; conferência: 0≥0; primeiro termo da condição é falso, segundo verdadeiro."
          },
          {
            "id": "f4-funcao-definida-por-partes-c",
            "label": "x≥0",
            "correct": true,
            "feedback": "Certo: resposta x≥0; conferência: 0≥0; primeiro termo da condição é falso, segundo verdadeiro."
          }
        ]
      }
    ],
    "medias": [
      {
